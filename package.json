{
  "name": "chat-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype renderer for synchronized chat videos",
  "scripts": {
    "audio:demo": "node scripts/generate-demo-audio.mjs",
    "elevenlabs:demo:user": "node --env-file=.env.local scripts/generate-elevenlabs-demo.mjs user",
    "elevenlabs:demo:assistant": "node --env-file=.env.local scripts/generate-elevenlabs-demo.mjs assistant",
    "xtts:setup": ".venv-xtts/bin/python scripts/xtts-generate.py --setup",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts ChatVideoPrototype output/prototype.mp4"
  },
  "dependencies": {
    "@remotion/player": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
