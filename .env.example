# Скопируйте этот файл как .env.local и вставьте ключ после знака =.
# Никогда не добавляйте .env.local в Git и не отправляйте его другим людям.
ELEVENLABS_API_KEY=

# Значения используются по умолчанию. Их можно переопределить в блоке «Озвучка».
ELEVENLABS_USER_VOICE_ID=
ELEVENLABS_ASSISTANT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Локальные абсолютные пути к чистым образцам голоса длительностью 10–30 секунд.
XTTS_USER_REFERENCE=
XTTS_ASSISTANT_REFERENCE=
XTTS_LANGUAGE=ru
XTTS_ALIGNMENT_MODEL=small
