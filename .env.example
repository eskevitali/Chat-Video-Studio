# Только для локального pnpm dev. Никогда не добавляйте .env.local в Git.
# ElevenLabs на сайте вводится в настройках приложения.
ELEVENLABS_API_KEY=
ELEVENLABS_USER_VOICE_ID=
ELEVENLABS_ASSISTANT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Вход через кабинет Lokvita. Пустое значение отключает авторизацию (только local).
LOKVITA_API_URL=
